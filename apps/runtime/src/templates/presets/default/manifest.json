    { "src": "scripts/post-edit-verify.mjs",     "dest": "/workspace/.codeck/scripts/post-edit-verify.mjs" },
    { "src": "scripts/pre-compact-hook.mjs",     "dest": "/workspace/.codeck/scripts/pre-compact-hook.mjs" },
    { "src": "scripts/learning-observer.mjs",    "dest": "/workspace/.codeck/scripts/learning-observer.mjs" },
