{
	"_attribution": "Source: affaan-m/everything-claude-code (MIT License) + Codeck hooks. Integrated into Codeck preset.",
	"plansDirectory": "./reports",
	"permissions": {
		"allow": [
			"Read",
			"Edit",
			"Write",
			"Bash",
			"WebFetch",
			"WebSearch",
			"Glob",
			"Grep",
			"Read(/workspace/.codeck/**)",
			"Edit(/workspace/.codeck/**)",
			"Edit(/root/.claude/**)",
			"Read(/root/.claude/**)",
			"mcp__playwright__browser_navigate",
			"mcp__playwright__browser_snapshot",
			"mcp__playwright__browser_click",
			"mcp__playwright__browser_type",
			"mcp__playwright__browser_fill_form",
			"mcp__playwright__browser_select_option",
			"mcp__playwright__browser_hover",
			"mcp__playwright__browser_drag",
			"mcp__playwright__browser_press_key",
			"mcp__playwright__browser_evaluate",
			"mcp__playwright__browser_run_code",
			"mcp__playwright__browser_navigate_back",
			"mcp__playwright__browser_take_screenshot",
			"mcp__playwright__browser_wait_for",
			"mcp__playwright__browser_file_upload",
			"mcp__playwright__browser_handle_dialog",
			"mcp__playwright__browser_tabs",
			"mcp__playwright__browser_close",
			"mcp__playwright__browser_install",
			"mcp__playwright__browser_resize",
			"mcp__playwright__browser_console_messages",
			"mcp__playwright__browser_network_requests",
			"mcp__context7__resolve-library-id",
			"mcp__context7__query-docs",
			"mcp__sequential-thinking__sequentialthinking",
			"mcp__eslint__lint-files",
			"mcp__token-optimizer__count_tokens",
			"mcp__token-optimizer__optimize_text",
			"mcp__token-optimizer__compress_text",
			"mcp__token-optimizer__smart_grep",
			"mcp__token-optimizer__smart_read",
			"mcp__token-optimizer__smart_edit",
			"mcp__token-optimizer__smart_write",
			"mcp__token-optimizer__smart_glob",
			"mcp__token-optimizer__smart_diff",
			"mcp__token-optimizer__smart_test",
			"mcp__token-optimizer__smart_build",
			"mcp__token-optimizer__smart_lint",
			"mcp__token-optimizer__smart_status"
		],
		"deny": [
			"Read(.env*)",
			"Read(**/credentials*)",
			"Read(**/.credentials*)",
			"Read(**/.ssh/*)",
			"Read(**/*.pem)",
			"Read(**/secrets/**)"
		]
	},
	"includeGitInstructions": false,
	"enableAllProjectMcpServers": true,
	"fallbackModel": "sonnet",
	"env": {
		"ENABLE_TOOL_SEARCH": "1"
	},
	"attribution": {
		"commit": "",
		"pr": ""
	},
	"statusLine": {
		"type": "command",
		"command": "bash /workspace/.codeck/scripts/statusline.sh"
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash|Edit|Write|MultiEdit|Agent",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/budget-guard.mjs"
					}
				],
				"description": "Hard budget/iteration kill switch while an autonomous-harness task is active"
			},
			{
				"matcher": "Agent",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/teams-reminder-hook.mjs",
						"if": "process.env.CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS === '1'"
					},
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/agent-auto-brief.mjs",
						"timeout": 5
					}
				]
			},
			{
				"matcher": "Edit|Write",
				"if": "Edit OR Write",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/skill-reminder-hook.mjs"
					}
				]
			},
			{
				"matcher": "Bash",
				"if": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/dangerous-cmd-guard.mjs"
					}
				]
			},
			{
				"matcher": "Edit|Write|Bash",
				"if": "Edit OR Write OR Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/decision-guidance.mjs"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Bash|Edit|Write|Read|Grep|Glob|WebFetch|WebSearch",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/no-progress-guard.mjs"
					}
				],
				"description": "Detect stuck loops (identical tool call repeated) and nudge a re-plan"
			},
			{
				"matcher": "Edit|Write",
				"if": "Edit OR Write",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/post-edit-verify.mjs"
					},
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/auto-format-hook.mjs",
						"async": true
					}
				]
			},
			{
				"matcher": "Read|Grep|Glob|Bash|WebFetch|WebSearch",
				"if": "Read OR Grep OR Glob OR Bash OR WebFetch OR WebSearch",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/tool-result-compressor.mjs"
					}
				]
			},
			{
				"matcher": "Edit|Write",
				"if": "Edit OR Write",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/edit-tracker.mjs",
						"timeout": 3
					}
				],
				"description": "Track file edits for workflow-checkpoint review enforcement"
			},
			{
				"matcher": "Edit|Write",
				"if": "Edit OR Write",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/async-test-runner.mjs",
						"async": true,
						"asyncRewake": true,
						"timeout": 65
					}
				],
				"description": "Run background tests after file edits and rewake model with results (requires CODECK_AUTO_TEST=1)"
			}
		],
		"PreCompact": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/pre-compact-hook.mjs"
					}
				]
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"/workspace/.codeck/scripts/ecc/run-with-flags.js\" \"pre:compact\" \"scripts/ecc/pre-compact.js\" \"standard,strict\""
					}
				],
				"description": "Save state before context compaction"
			}
		],
		"PostCompact": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/post-compact-hook.mjs"
					}
				]
			},
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/harness-resume-hook.mjs",
						"timeout": 3
					}
				],
				"description": "Re-inject active harness state after compaction so the task resumes exactly"
			}
		],
		"UserPromptSubmit": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/autonomous-protocol-hook.mjs",
						"timeout": 3
					}
				],
				"description": "Inject the Autonomous Operator Protocol each task (message layer \u2014 keeps the cached prefix stable)"
			},
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/task-classifier-hook.mjs",
						"timeout": 3
					}
				],
				"description": "Classify the task type and point at the matching playbook (adaptive protocol)"
			},
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/session-context-hook.mjs",
						"timeout": 3
					}
				],
				"description": "Inject session memory context on first message (KV-cache optimization \u2014 keeps CLAUDE.md static)"
			},
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/memory-nudge-hook.mjs"
					}
				]
			},
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/context-injector.mjs",
						"timeout": 3
					}
				],
				"description": "Inject available MCP tools, skills, and workflow hints based on task type"
			},
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/capability-doctor.mjs --inject",
						"timeout": 6
					}
				],
				"description": "Inject an environment-capabilities preflight (only NOT-ready capabilities + fallbacks) on the first message"
			}
		],
		"Stop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/memory-stop-hook.mjs"
					}
				]
			},
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/skill-metrics-hook.mjs",
						"async": true,
						"timeout": 5
					}
				],
				"description": "Track which skills and agents were used per session for performance analysis"
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"/workspace/.codeck/scripts/ecc/run-with-flags.js\" \"stop:check-console-log\" \"scripts/ecc/check-console-log.js\" \"standard,strict\""
					}
				],
				"description": "Check for console.log in modified files after each response"
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"/workspace/.codeck/scripts/ecc/run-with-flags.js\" \"stop:session-end\" \"scripts/ecc/session-end.js\" \"minimal,standard,strict\"",
						"async": true,
						"timeout": 10
					}
				],
				"description": "Persist session state after each response (Stop carries transcript_path)"
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"/workspace/.codeck/scripts/ecc/run-with-flags.js\" \"stop:evaluate-session\" \"scripts/ecc/evaluate-session.js\" \"minimal,standard,strict\"",
						"async": true,
						"timeout": 10
					}
				],
				"description": "Evaluate session for extractable patterns"
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"/workspace/.codeck/scripts/ecc/run-with-flags.js\" \"stop:cost-tracker\" \"scripts/ecc/cost-tracker.js\" \"minimal,standard,strict\"",
						"async": true,
						"timeout": 10
					}
				],
				"description": "Track token and cost metrics per session"
			},
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/skill-proposal-hook.mjs",
						"async": true,
						"timeout": 10
					}
				],
				"description": "Detect repeated workflow patterns and propose new skills"
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/workflow-checkpoint.mjs",
						"timeout": 5
					}
				],
				"description": "Block stop if significant code changes lack review \u2014 forces implement\u2192review\u2192present flow"
			}
		],
		"SessionEnd": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/memory-consolidation.mjs",
						"async": true
					}
				]
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"/workspace/.codeck/scripts/ecc/run-with-flags.js\" \"session:end:marker\" \"scripts/ecc/session-end-marker.js\" \"minimal,standard,strict\"",
						"async": true,
						"timeout": 10
					}
				],
				"description": "Session end lifecycle marker (non-blocking)"
			}
		],
		"SessionStart": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/harness-resume-hook.mjs",
						"timeout": 3
					}
				],
				"description": "Resume an active autonomous-harness task after restart/rebuild"
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/credential-persist.mjs",
						"timeout": 5
					}
				],
				"description": "Restore integration credentials (symlinks) after container rebuild"
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"/workspace/.codeck/scripts/ecc/run-with-flags.js\" \"session:start\" \"scripts/ecc/session-start.js\" \"minimal,standard,strict\""
					}
				],
				"description": "Load previous context and detect package manager on new session"
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/skill-index-generator.mjs",
						"timeout": 5
					}
				],
				"description": "Generate compact skill index for progressive disclosure"
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/config-watcher.mjs",
						"timeout": 3
					}
				],
				"description": "Register config/preferences/memory paths to watch for hot-reload changes"
			},
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/capability-doctor.mjs --probe",
						"async": true,
						"timeout": 6
					}
				],
				"description": "Probe external capabilities (gh auth, git remote, docker, runtimes, browser, network, disk) with real execution and cache the result for the preflight injection"
			}
		],
		"FileChanged": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/config-changed.mjs",
						"timeout": 3
					}
				],
				"description": "Inject updated config/preferences/memory content when watched files change"
			}
		],
		"PostToolUseFailure": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "node \"/workspace/.codeck/scripts/ecc/run-with-flags.js\" \"post:mcp-health-check\" \"scripts/ecc/mcp-health-check.js\" \"standard,strict\""
					}
				],
				"description": "Track failed MCP tool calls, mark unhealthy servers, and attempt reconnect"
			}
		],
		"StopFailure": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/stop-failure-hook.mjs"
					}
				],
				"description": "Log API failures for diagnostics"
			}
		],
		"SubagentStart": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/subagent-tracker.mjs"
					}
				],
				"description": "Track subagent lifecycle for real-time UI panel"
			}
		],
		"SubagentStop": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/subagent-tracker.mjs"
					}
				],
				"description": "Track subagent completion for real-time UI panel"
			}
		],
		"CwdChanged": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/cwd-changed-hook.mjs"
					}
				],
				"description": "Auto-detect project type and available env vars on directory change"
			}
		],
		"Elicitation": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/mcp-auto-config.mjs",
						"timeout": 3
					}
				],
				"description": "Auto-fill MCP server configuration from stored credentials in .codeck/.env"
			}
		],
		"TeammateIdle": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/team-events.mjs",
						"timeout": 3
					}
				],
				"description": "Track teammate idle status for team activity panel"
			}
		],
		"TaskCompleted": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "node /workspace/.codeck/scripts/team-events.mjs",
						"timeout": 3
					}
				],
				"description": "Track completed tasks for team activity panel"
			}
		]
	}
}
