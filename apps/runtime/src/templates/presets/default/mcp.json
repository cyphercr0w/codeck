{
	"mcpServers": {
		"context7": {
			"command": "npx",
			"args": ["-y", "@upstash/context7-mcp"],
			"description": "Look up current library documentation and code examples"
		},
		"sequential-thinking": {
			"command": "npx",
			"args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
		},
		"eslint": {
			"command": "npx",
			"args": ["-y", "@eslint/mcp"]
		},
		"playwright": {
			"command": "npx",
			"args": ["-y", "@playwright/mcp@latest", "--headless", "--no-sandbox"]
		},
		"brave-search": {
			"command": "npx",
			"args": ["-y", "@anthropic-ai/mcp-server-brave-search"],
			"env": {
				"BRAVE_API_KEY": ""
			},
			"description": "Web search via Brave Search API"
		},
		"github": {
			"command": "npx",
			"args": ["-y", "@anthropic-ai/mcp-server-github"],
			"env": {
				"GITHUB_TOKEN": ""
			},
			"description": "GitHub repos, PRs, issues, and code search"
		}
	}
}
